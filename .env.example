# ─────────────────────────────────────────────────────────────────────────────
# Floscent – Environment Variables
# Copy this file to .env and fill in the values.
# On Railway, set these in the project's Variables tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Railway: add a PostgreSQL plugin and it sets DATABASE_URL automatically.
# Local dev: use a local Postgres or run: docker run -e POSTGRES_PASSWORD=dev \
#   -p 5432:5432 postgres:16
DATABASE_URL="postgresql://user:password@host:5432/floscent"

# ── App ───────────────────────────────────────────────────────────────────────
# Railway: set to your Railway-generated domain, e.g. https://floscent.up.railway.app
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
APP_NAME="Floscent"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="change-me-use-openssl-rand-base64-32"

# ── Admin account (created on first boot via seed) ────────────────────────────
ADMIN_EMAIL="admin@floscent.com"
ADMIN_PASSWORD="Admin@123456"

# ── OpenAI (optional – used for AI quote/proposal generation) ─────────────────
OPENAI_API_KEY="sk-..."

# ── Stripe (optional – used for payment processing) ───────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email / SMTP (optional – used for notifications) ─────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@floscent.com"
FROM_NAME="Floscent"
